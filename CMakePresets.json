{
  "version": 8,
  "configurePresets": [
    {
      "name": "vs-2026-amd64",
      "displayName": "VS 2026 amd64",
      "description": "Visual Studio 18 2026 x64；Debug/Release 在编的时候选",
      "generator": "Visual Studio 18 2026",
      "toolset": "host=x64",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "C:\\vcpkg\\scripts\\buildsystems\\vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/.github/manifest",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "vs-2026-amd64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "vs-2026-amd64",
      "configuration": "Release"
    }
  ]
}
